## 工作维度 → 中文（UI 显示用）
static func work_label(key: String) -> String:
	var m := {
		"cultivate": "修炼", "atk": "武力", "break": "突破", "death": "死亡",
		"explore": "探索", "plant": "种植", "mine": "采矿", "refine": "炼丹",
		"forge": "炼器", "sell": "售价", "qi": "灵气", "write": "撰写",
	}
	return m.get(key, key)
